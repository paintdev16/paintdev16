---
import Layout from "../layouts/Layout.astro";
import Card from "@/components/Card.astro";
import {
  Brain, Cpu, Car, FlaskConical, Cloud, Apple, ArrowRight, LayoutGrid,
} from "lucide-astro";
import { getCollection, type CollectionEntry } from "astro:content";

const notas: CollectionEntry<"notas">[] = await getCollection("notas");
notas.sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const iconMap: Record<string, any> = {
  Hardware: Cpu, Apple: Apple, IA: Brain,
  Automotriz: Car, Ciencia: FlaskConical, Cloud: Cloud,
};

const categorias = [
  { badge: "IA", label: "Inteligencia Artificial", desc: "Modelos, agentes autónomos y el futuro del aprendizaje automático", icon: Brain, variant: "info" as const },
  { badge: "Hardware", label: "Hardware", desc: "GPUs, chips cuánticos y la infraestructura que impulsa la IA", icon: Cpu, variant: "success" as const },
  { badge: "Automotriz", label: "Automotriz", desc: "Vehículos autónomos y movilidad eléctrica", icon: Car, variant: "warning" as const },
  { badge: "Ciencia", label: "Ciencia", desc: "Computación cuántica, biotech y las fronteras del conocimiento", icon: FlaskConical, variant: "neutral" as const },
  { badge: "Cloud", label: "Cloud", desc: "Infraestructura cloud, soberanía de datos y edge computing", icon: Cloud, variant: "secondary" as const },
  { badge: "Apple", label: "Apple", desc: "Ecosistema Apple, iOS, hardware e inteligencia artificial", icon: Apple, variant: "primary" as const },
];

const catAccent: Record<string, { bg: string; text: string; ring: string; glow: string; gradient: string; bar: string }> = {
  info: { bg: "bg-info/10", text: "text-info", ring: "ring-info/20", glow: "bg-info/5", gradient: "from-info/10 via-info/5 to-transparent", bar: "bg-info" },
  success: { bg: "bg-success/10", text: "text-success", ring: "ring-success/20", glow: "bg-success/5", gradient: "from-success/10 via-success/5 to-transparent", bar: "bg-success" },
  warning: { bg: "bg-warning/10", text: "text-warning", ring: "ring-warning/20", glow: "bg-warning/5", gradient: "from-warning/10 via-warning/5 to-transparent", bar: "bg-warning" },
  neutral: { bg: "bg-muted", text: "text-muted-foreground", ring: "ring-border", glow: "bg-muted/50", gradient: "from-foreground/5 via-transparent to-transparent", bar: "bg-foreground/30" },
  secondary: { bg: "bg-secondary/10", text: "text-secondary", ring: "ring-secondary/20", glow: "bg-secondary/5", gradient: "from-secondary/10 via-secondary/5 to-transparent", bar: "bg-secondary" },
  primary: { bg: "bg-primary/10", text: "text-primary", ring: "ring-primary/20", glow: "bg-primary/5", gradient: "from-primary/10 via-primary/5 to-transparent", bar: "bg-primary" },
};
---

<Layout>
  <section class="relative overflow-hidden border-b border-border">
    <div class="absolute inset-0 bg-linear-to-b from-primary/5 via-info/5 to-background pointer-events-none" />
    <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20 lg:py-24 relative">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-primary/10 text-primary ring-1 ring-primary/20 mb-5">
        <LayoutGrid class="size-6" />
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-3 leading-tight">
        Categorías
      </h1>
      <p class="text-muted-foreground text-sm sm:text-base max-w-xl leading-relaxed">
        Explora <strong class="text-foreground font-semibold">{notas.length} artículos</strong> organizados por tema. Cada categoría agrupa las notas más relevantes sobre esa área.
      </p>

      <nav class="mt-8 flex flex-wrap gap-2">
        {categorias.map((cat) => {
          const count = notas.filter((n) => n.data.badge === cat.badge).length;
          if (count === 0) return null;
          const a = catAccent[cat.variant];
          return (
            <a
              href={`#${cat.badge}`}
              class={["inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium ring-1 transition-all duration-200 hover:scale-105 active:scale-95", a.bg, a.text, a.ring].join(" ")}
            >
              <cat.icon class="size-3.5" />
              {cat.label}
            </a>
          );
        })}
      </nav>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <div class="space-y-20">
      {categorias.map((cat) => {
        const artículos = notas.filter((n) => n.data.badge === cat.badge);
        if (artículos.length === 0) return null;
        const a = catAccent[cat.variant];
        return (
          <section id={cat.badge} class="scroll-mt-24">   
            <div class={["relative rounded-2xl overflow-hidden mb-8 border border-border/50", a.gradient].join(" ")}>
              <div class={["absolute top-0 left-0 w-[3px] h-full", a.bar].join(" ")} />
              <div class="p-5 sm:p-6 flex items-center gap-4">
                <div class={["flex items-center justify-center w-11 h-11 rounded-xl shrink-0 ring-1", a.bg, a.text, a.ring].join(" ")}>
                  <cat.icon class="size-5" />
                </div>
                <div class="min-w-0">
                  <h2 class="text-lg sm:text-xl font-bold tracking-tight">{cat.label}</h2>
                  <p class="text-xs sm:text-sm text-muted-foreground">{cat.desc}</p>
                </div>
                <span class={["ml-auto shrink-0 inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium ring-1", a.bg, a.text, a.ring].join(" ")}>
                  {artículos.length} {artículos.length === 1 ? "nota" : "notas"}
                </span>
              </div>
            </div>
            <div class="grid gap-6 sm:gap-8 sm:grid-cols-2 lg:grid-cols-3">
              {artículos.map((nota) => {
                const Icon = iconMap[nota.data.badge] ?? Brain;
                return (
                  <Card
                    title={nota.data.title}
                    variant={nota.data.variant}
                    badge={nota.data.badge}
                    image={nota.data.image}
                    imageAlt={nota.data.imageAlt}
                    subtitle={nota.data.subtitle}
                    href={`/article/${nota.id}`}
                    size="sm"
                    iconSize="sm"
                  >
                    <Fragment slot="icon"><Icon /></Fragment>
                    <p class="text-xs">{nota.data.summary}</p>
                    <Fragment slot="footer">
                      <p class="text-xs text-muted-foreground">Leer nota →</p>
                    </Fragment>
                  </Card>
                );
              })}
            </div>
          </section>
        );
      })}
    </div>
  </section>
</Layout>