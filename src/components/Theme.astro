---
import { Sun, Moon, Monitor } from "lucide-astro";
---
<script is:inline>
  (function () {
    try {
      const t = localStorage.getItem("theme");
      if (t === "dark" || (!t && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.setAttribute("data-theme", "dark");
      } else if (t === "light") {
        document.documentElement.setAttribute("data-theme", "light");
      }
    } catch (e) {}
  })();
</script>

<style is:inline>
  .theme-transition-lock,
  .theme-transition-lock *,
  .theme-transition-lock *::before,
  .theme-transition-lock *::after {
    transition: none !important;
  }
</style>

<button
  type="button"
  id="theme-toggle"
  aria-label="Cambiar tema (actual: sistema)"
  title="Cambiar tema"
  transition:persist="theme-toggle"
  class="relative inline-flex h-9 w-9 items-center justify-center rounded-lg text-muted-foreground transition-all duration-200 hover:bg-muted hover:text-foreground active:scale-95"
>
  <Sun
    class="theme-icon absolute size-[18px] transition-all duration-300"
    data-icon="light"
  />
  <Moon
    class="theme-icon absolute size-[18px] transition-all duration-300"
    data-icon="dark"
  />
  <Monitor
    class="theme-icon absolute size-[18px] transition-all duration-300"
    data-icon="system"
  />
</button>

<script>
  type Theme = "light" | "dark" | "system";
  const THEME_KEY = "theme";

  function getSavedTheme(): Theme | null {
    try {
      return localStorage.getItem(THEME_KEY) as Theme | null;
    } catch {
      return null;
    }
  }

  function setSavedTheme(theme: Theme) {
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {}
  }

  function applyTheme(theme: Theme) {
    const root = document.documentElement;
    root.classList.add("theme-transition-lock");

    if (theme === "system") {
      root.removeAttribute("data-theme");
    } else {
      root.setAttribute("data-theme", theme);
    }
    setSavedTheme(theme);
    updateThemeIcons(theme);

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        root.classList.remove("theme-transition-lock");
      });
    });
  }

  function updateThemeIcons(current: Theme) {
    document.querySelectorAll<HTMLElement>(".theme-icon").forEach((icon) => {
      const name = icon.getAttribute("data-icon");
      const isActive = name === current;
      icon.style.opacity = isActive ? "1" : "0";
      icon.style.transform = isActive
        ? "scale(1) rotate(0deg)"
        : "scale(0.5) rotate(-45deg)";
    });

    const btn = document.getElementById("theme-toggle");
    if (btn) {
      const label = `Cambiar tema (actual: ${current === "system" ? "sistema" : current})`;
      btn.setAttribute("aria-label", label);
      btn.setAttribute("title", label);
    }
  }

  function initTheme() {
    const savedTheme = getSavedTheme();
    if (savedTheme) applyTheme(savedTheme);
    else updateThemeIcons("system");

    const btn = document.getElementById("theme-toggle");
    if (btn && !btn.hasAttribute("data-theme-initialized")) {
      btn.setAttribute("data-theme-initialized", "true");

      btn.addEventListener("click", () => {
        const current = getSavedTheme() ?? "system";
        const next: Theme =
          current === "light" ? "dark" : current === "dark" ? "system" : "light";
        applyTheme(next);
      });
    }
  }

  document.addEventListener("astro:page-load", initTheme);

  // Fallback si no usas Astro ClientRouter / View Transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTheme);
  } else {
    initTheme();
  }

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", () => {
      const saved = getSavedTheme();
      if (!saved || saved === "system") {
        updateThemeIcons("system");
      }
    });
</script>