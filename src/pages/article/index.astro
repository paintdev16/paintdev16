---
import Card from "@/components/Card.astro";
import Layout from "@/layouts/Layout.astro";
import {
  Cpu, Apple, Brain, Car, FlaskConical, Cloud, ScanLine,
} from "lucide-astro";

import { getCollection, type CollectionEntry } from "astro:content";

const iconMap: Record<string, any> = {
  Hardware: Cpu,
  Apple: Apple,
  IA: Brain,
  Automotriz: Car,
  Ciencia: FlaskConical,
  Cloud: Cloud,
};

const notas: CollectionEntry<"notas">[] = await getCollection("notas");
notas.sort(
  (a: CollectionEntry<"notas">, b: CollectionEntry<"notas">) =>
    b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const total = notas.length;
---

<Layout>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3">
        Últimas noticias
      </h1>
      <p class="text-muted-foreground text-sm sm:text-base max-w-2xl">
        {total} {total === 1 ? "artículo" : "artículos"} sobre tecnología, ciencia e innovación. Actualizado en tiempo real.
      </p>
    </header>
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    {
      notas.map((nota) => {
        const Icon = iconMap[nota.data.badge] ?? ScanLine;
        return (
        <Card
          title={nota.data.title}
          variant={nota.data.variant}
          badge={nota.data.badge}
          image={nota.data.image}
          imageAlt={nota.data.imageAlt}
          subtitle={nota.data.subtitle}
          href={`/article/${nota.id}`}
        >
          <Fragment slot="icon"><Icon /></Fragment>
          <p>{nota.data.summary}</p>
          <Fragment slot="footer">
            <p>Ver detalle →</p>
          </Fragment>
        </Card>
        );
      })
    }
    </div>
  </section>
</Layout>
