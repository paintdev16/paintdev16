---
// Button.astro
import { tv, type VariantProps } from "tailwind-variants";
import type { HTMLAttributes } from "astro/types";

const button = tv({
  base: "inline-flex items-center justify-center gap-2 rounded-md font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 aria-disabled:pointer-events-none aria-disabled:opacity-50 [&_svg]:shrink-0",
  variants: {
    variant: {
      primary: "bg-primary text-primary-foreground hover:bg-primary/90",
      secondary: "bg-secondary text-secondary-foreground hover:bg-secondary/90",
      success: "bg-success text-success-foreground hover:bg-success/90",
      danger: "bg-danger text-danger-foreground hover:bg-danger/90",
      warning: "bg-warning text-warning-foreground hover:bg-warning/90",
      info: "bg-info text-info-foreground hover:bg-info/90",
      outline:
        "border border-border bg-transparent text-foreground hover:bg-muted hover:text-foreground",
      ghost: "bg-transparent text-foreground hover:bg-muted hover:text-foreground",
    },
    size: {
      sm: "h-8 px-3 text-sm [&_svg]:size-4",
      md: "h-10 px-4 text-sm [&_svg]:size-4",
      lg: "h-12 px-6 text-base [&_svg]:size-5",
    },
    iconOnly: {
      true: "px-0",
      false: "",
    },
  },
  compoundVariants: [
    { iconOnly: true, size: "sm", class: "w-8" },
    { iconOnly: true, size: "md", class: "w-10" },
    { iconOnly: true, size: "lg", class: "w-12" },
  ],
  defaultVariants: {
    variant: "primary",
    size: "md",
    iconOnly: false,
  },
});

type ButtonVariants = VariantProps<typeof button>;

type Props = HTMLAttributes<"button"> &
  HTMLAttributes<"a"> &
  ButtonVariants & {
    class?: string;
    href?: string;
    type?: "button" | "submit" | "reset";
    /** Marca el botón como "solo icono": quita padding horizontal y lo hace cuadrado */
    iconOnly?: boolean;
    /** Requerido cuando iconOnly=true, para accesibilidad */
    ariaLabel?: string;
    /** Muestra el botón en estado de carga y lo deshabilita */
    loading?: boolean;
  };

const {
  variant,
  size,
  type = "button",
  disabled = false,
  class: className,
  iconOnly = false,
  ariaLabel,
  loading = false,
  href,
  ...rest
} = Astro.props;

if (iconOnly && !ariaLabel) {
  console.warn(
    "[Button.astro] iconOnly=true requiere la prop `ariaLabel` para accesibilidad.",
  );
}

const Tag = href ? "a" : "button";
const isButton = Tag === "button";
const isDisabled = disabled || loading;
const hasIconSlot = Astro.slots.has("icon");
---

<Tag
  {...rest}
  href={isButton ? undefined : href}
  type={isButton ? type : undefined}
  disabled={isButton ? isDisabled : undefined}
  aria-disabled={!isButton && isDisabled ? "true" : undefined}
  aria-label={iconOnly ? ariaLabel : undefined}
  aria-busy={loading ? "true" : undefined}
  class={button({ variant, size, iconOnly, class: className })}
>
  {
    loading ? (
      <svg
        class="size-4 animate-spin"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <circle
          class="opacity-25"
          cx="12"
          cy="12"
          r="10"
          stroke="currentColor"
          stroke-width="4"
        />
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        />
      </svg>
    ) : iconOnly ? (
      hasIconSlot ? (
        <slot name="icon" />
      ) : (
        <slot />
      )
    ) : (
      <>
        <slot name="icon-start" />
        <slot />
        <slot name="icon-end" />
      </>
    )
  }
</Tag>
